{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aurix-core-banking.github.io/aurix-openfinance/schemas/policies.schema.json",
  "title": "Policies Spec",
  "type": "object",
  "required": ["specVersion", "kind", "metadata", "invariants"],
  "properties": {
    "specVersion": { "type": "string" },
    "kind": { "type": "string", "enum": ["Policies"] },
    "metadata": { "type": "object", "required": ["name"] },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rule", "severity", "enforcement"],
        "properties": {
          "id": { "type": "string", "pattern": "^INV-\\d+$" },
          "rule": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "enforcement": { "type": "string", "enum": ["runtime", "ci", "architecture-test"] },
          "description": { "type": "string" },
          "violation": { "type": "string" },
          "test": { "type": "string" }
        }
      }
    },
    "policyRules": { "type": "object" },
    "compliance": { "type": "object" }
  }
}
