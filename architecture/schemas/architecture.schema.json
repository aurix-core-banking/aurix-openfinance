{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aurix-core-banking.github.io/aurix-openfinance/schemas/architecture.schema.json",
  "title": "Architecture Spec",
  "description": "Validates architecture.yaml",
  "type": "object",
  "required": ["specVersion", "kind", "metadata", "invariants", "planes", "domains", "pipeline"],
  "properties": {
    "specVersion": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "kind": { "type": "string", "enum": ["Architecture"] },
    "metadata": {
      "type": "object",
      "required": ["name", "architectureStyle"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "architectureStyle": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "technology": { "type": "object" },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rule", "severity"],
        "properties": {
          "id": { "type": "string", "pattern": "^INV-\\d+$" },
          "rule": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "description": { "type": "string" }
        }
      }
    },
    "planes": { "type": "object" },
    "domains": { "type": "object" },
    "pipeline": { "type": "object" },
    "idempotency": { "type": "object" },
    "traceability": { "type": "object" },
    "security": { "type": "object" },
    "observability": { "type": "object" },
    "failureHandling": { "type": "object" }
  }
}
